@echo off
chcp 65001 > nul
echo ========================================================
echo   HOPES & DREAMS // 희망과 꿈 (Epic Orchestral Sanctuary)
echo ========================================================
echo.
echo [1] 토비 폭스(Toby Fox)의 Hopes and Dreams 스타일 오케스트라 헌정곡 탑재
echo [2] 무지개 의지의 별(Rainbow Save Star), 여명의 빛 기둥, 성운 프리즘
echo [3] [D]키를 눌러 쏟아지는 찬란한 의지(Determination)의 별빛 폭발
echo [4] 내 Hopes and Dreams / 언더테일 / 웅장한 OST 파일 드래그앤드롭 재생
echo.
echo 단축키 안내:
echo   - [Space] : 음악 재생 / 일시정지
echo   - [D] : 의지(DETERMINATION) 별빛 대폭발
echo   - [H] : UI 숨김 / 순수 감상 모드 (Zen Mode)
echo   - [P] : 트랙 목록 사이드바 열기/닫기
echo   - [F] : 전체화면 모드
echo   - [화면 클릭] : 클릭 지점에 별빛 생성
echo.
echo 브라우저에서 희망과 꿈의 공간을 여는 중입니다...
start "" "%~dp0epic_hopes_and_dreams.html"
exit
